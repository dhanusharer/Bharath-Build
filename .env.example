# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. DO NOT commit actual secrets to version control.
# ==============================================================================

# Application Environment (local | dev | staging | prod)
APP_ENV=local
DEBUG=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & CORS
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database Configuration
POSTGRES_DB=medication_access_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medication_access_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Bharat Builds - Multimodal Medication Accessibility"

# AWS Infrastructure (Uses credential chain, AWS SSO, or profile. Do NOT put long-lived secrets in production files)
AWS_REGION=ap-south-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=placeholder-aws-access-key
AWS_SECRET_ACCESS_KEY=placeholder-aws-secret-key

# Amazon S3 Storage
S3_BUCKET_NAME=medication-access-artifacts-dev
S3_PRESIGNED_EXPIRATION_SECONDS=900

# Amazon Bedrock Foundation Models (Must be supplied via environment; do NOT assume Claude 3.5 Sonnet)
# Examples: amazon.nova-pro-v1:0, amazon.nova-lite-v1:0, or approved regional multimodal model ID
BEDROCK_MODEL_ID=your-bedrock-multimodal-model-id
BEDROCK_FALLBACK_MODEL_ID=
BEDROCK_REGION=ap-south-1
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0.0
BEDROCK_TIMEOUT_SECONDS=30.0
BEDROCK_MAX_RETRIES=2

# Amazon Transcribe
TRANSCRIBE_LANGUAGE_CODE=hi-IN
TRANSCRIBE_SECONDARY_LANGUAGE_CODE=kn-IN
TRANSCRIBE_SAMPLE_RATE_HERTZ=16000

# Text-to-Speech (TTS) Provider Abstraction
# Supported providers: polly | mock | custom_regional_provider
TTS_DEFAULT_PROVIDER=polly
TTS_FALLBACK_PROVIDER=mock
POLLY_VOICE_ID_HINDI=Kajal
POLLY_ENGINE_HINDI=neural
# Note: Kannada TTS provider must be configured based on regional provider evaluation
TTS_KANNADA_PROVIDER=mock
